<Window x:Class="LinkView.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LinkView" Width="1220" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.Text}" FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource FontSize.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边导航 -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="60" Margin="18,0,14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                            <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource Font.Icon}" FontSize="15"
                                       Foreground="{DynamicResource Brush.TextOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LinkView" FontFamily="{DynamicResource Font.Display}" FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="屏幕共享" Style="{StaticResource Text.Caption}" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,14">
                    <!-- 活动会话 -->
                    <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,8"
                            Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse Width="8" Height="8" Fill="{Binding SessionState, Converter={StaticResource StateBrush}}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SessionStateLabel}" Style="{StaticResource Text.Label}"
                                           Foreground="{Binding SessionState, Converter={StaticResource StateBrush}}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding PeerName}" FontWeight="SemiBold" Margin="0,7,0,10"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Content="停止共享" Style="{StaticResource Button.DangerSoft}"
                                    Command="{Binding StopSharingCommand}" HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 本机信息 -->
                    <Border Style="{StaticResource Card.Flat}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding NetworkSummary}" Style="{StaticResource Text.Caption}" FontSize="10.5"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#xE713;" Style="{StaticResource Button.Icon}"
                                    FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                                    Command="{Binding OpenSettingsCommand}" ToolTip="打开设置"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Success}"
                                 Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}"
                                 Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding DiscoverySummary}" Style="{StaticResource Text.Caption}"
                                   FontSize="10.5" Margin="7,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="NavList" Style="{StaticResource NavList}" Margin="0,4,0,0"
                         ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource Font.Icon}" FontSize="15"
                                           Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧主区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown" MouseRightButtonUp="TitleBar_OnMouseRightButtonUp">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Caption}" Click="MinimizeClick" ToolTip="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="{DynamicResource Font.Icon}" FontSize="10"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Click="MaximizeClick" ToolTip="最大化">
                            <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="{DynamicResource Font.Icon}" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource Button.CaptionClose}" Click="CloseClick" ToolTip="关闭">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource Font.Icon}" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 页面标题栏 -->
                <Grid Grid.Row="0" Margin="32,10,32,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Text.PageTitle}"/>
                        <TextBlock Text="{Binding CurrentDescription}" Style="{StaticResource Text.Secondary}"
                                   FontSize="12.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="{DynamicResource R.Pill}" Padding="11,5"
                                Background="{Binding SessionState, Converter={StaticResource StateSoftBrush}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding SessionState, Converter={StaticResource StateBrush}}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SessionStateLabel}" Margin="7,0,0,0"
                                           Foreground="{Binding SessionState, Converter={StaticResource StateBrush}}"
                                           FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <Button Content="停止共享" Style="{StaticResource Button.DangerSoft}" Margin="10,0,0,0"
                                Command="{Binding StopSharingCommand}"
                                Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageTranslate" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- 连接请求确认 -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource Brush.Overlay}"
              Visibility="{Binding HasPendingJoin, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="430" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="&#xE8EA;" FontFamily="{DynamicResource Font.Icon}" FontSize="19"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="收到连接请求" Style="{StaticResource Text.Hero}" FontSize="22" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding PendingJoinName}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock Text="{Binding PendingJoinDetail}" Style="{StaticResource Text.Secondary}"/>
                    <Border Style="{StaticResource Banner.Info}" Margin="0,16,0,0">
                        <TextBlock Text="只有在确认对方身份后才应允许连接。连接建立后你仍可以随时停止共享或断开。"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="拒绝" Style="{StaticResource Button.Secondary}" MinWidth="88"
                                Command="{Binding RejectJoinCommand}"/>
                        <Button Content="允许连接" Style="{StaticResource Button.Primary}" MinWidth="108" Margin="10,0,0,0"
                                Command="{Binding AcceptJoinCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 全局通知 -->
        <Border x:Name="ToastHost" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,26" MaxWidth="620" Padding="14,10" CornerRadius="{DynamicResource R.Md}"
                Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock x:Name="ToastIcon" Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="14"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource Button.Icon}"
                        FontFamily="{DynamicResource Font.Icon}" FontSize="10" Width="26" Height="26"
                        Command="{Binding DismissToastCommand}"/>
                <TextBlock Text="{Binding ToastText}" Margin="10,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
