<UserControl x:Class="LinkView.Windows.Views.ShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,0,32,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- 画面区域 -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.VideoBackground}" CornerRadius="{DynamicResource R.Lg}"
                ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" MinHeight="300">
            <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding ViewIndex, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=0}"/>
                <Image Source="{Binding RemoteImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding ViewIndex, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=1}"/>

                <!-- 无画面提示 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding PreviewImage}" Value="{x:Null}"/>
                                        <Condition Binding="{Binding ViewIndex}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RemoteImage}" Value="{x:Null}"/>
                                        <Condition Binding="{Binding ViewIndex}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource Font.Icon}" FontSize="34"
                               HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
                    <TextBlock Text="暂无画面" Foreground="#CCFFFFFF" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#88FFFFFF" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 顶部信息 -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" Background="#99080C12"
                        CornerRadius="6" Padding="9,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#4C9AFF" VerticalAlignment="Center"/>
                        <TextBlock Text="本机预览" Foreground="White" FontSize="11" Margin="7,0,0,0"
                                   Visibility="{Binding ViewIndex, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=0}"/>
                        <TextBlock Text="对方画面" Foreground="White" FontSize="11" Margin="7,0,0,0"
                                   Visibility="{Binding ViewIndex, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=1}"/>
                        <TextBlock Text="{Binding OutputInfo}" Foreground="#AAFFFFFF" FontSize="11" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底部控制 -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#99080C12" Padding="12,9">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <RadioButton GroupName="ShareViewMode" Style="{StaticResource Chip}" Content="本机画面"
                                         IsChecked="{Binding ViewIndex, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=TwoWay}"/>
                            <RadioButton GroupName="ShareViewMode" Style="{StaticResource Chip}" Content="对方画面"
                                         IsChecked="{Binding ViewIndex, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Ghost}" Foreground="White" Command="{Binding FullscreenCommand}"
                                    ToolTip="全屏查看">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE740;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                                               Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="全屏" Margin="6,0,0,0" Foreground="White" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 控制面板 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,28">
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="会话" Style="{StaticResource Text.Section}"/>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding PeerName}" FontSize="10.5" Style="{StaticResource Text.Caption}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <Button Content="前往连接中心" Style="{StaticResource Button.Secondary}" Margin="0,12,0,0"
                                Command="{Binding GoToConnectCommand}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <Button Content="开始共享" Style="{StaticResource Button.Primary}" Padding="14,9"
                                Command="{Binding StartSharingCommand}" IsEnabled="{Binding CanStart}"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="7"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="暂停" Style="{StaticResource Button.Secondary}" Command="{Binding PauseCommand}"
                                    IsEnabled="{Binding CanPause}"/>
                            <Button Grid.Column="2" Content="恢复" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}"/>
                        </Grid>
                        <Button Content="停止共享" Style="{StaticResource Button.Danger}" Margin="0,7,0,0" Padding="14,9"
                                Command="{Binding StopSharingCommand}" IsEnabled="{Binding CanStop}"/>
                        <TextBlock Text="停止共享会立即释放采集资源，画面不会继续发送。" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="采集源" Style="{StaticResource Text.Section}"/>
                            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right"
                                    Command="{Binding RefreshSourceListCommand}" ToolTip="刷新采集源">
                                <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextTertiary}"/>
                            </Button>
                        </Grid>
                        <ComboBox Style="{StaticResource ComboBox}" ItemsSource="{Binding Sources}" Margin="0,8,0,0"
                                  SelectedItem="{Binding SelectedSource}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="10.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding CaptureHint}" Style="{StaticResource Text.Caption}" Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                        <Button Content="应用并重新采集" Style="{StaticResource Button.Ghost}" Margin="0,6,0,0"
                                HorizontalAlignment="Left" Command="{Binding ApplySourceCommand}"
                                Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="画质" Style="{StaticResource Text.Section}"/>
                        <ComboBox Style="{StaticResource ComboBox}" ItemsSource="{Binding PresetOptions}" Margin="0,8,0,0"
                                  SelectedIndex="{Binding SelectedPresetIndex}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding QualityNote}" Style="{StaticResource Text.Caption}" Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding QualityNote, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                        <TextBlock Text="更细的分辨率、码率与编码参数请在高级设置中调整。" Style="{StaticResource Text.Caption}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
