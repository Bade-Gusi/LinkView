<UserControl x:Class="LinkView.Windows.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="32,0,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：状态与设备 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding SessionState, Converter={StaticResource StateSoftBrush}}"
                                    CornerRadius="{DynamicResource R.Pill}" Padding="9,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding SessionState, Converter={StaticResource StateBrush}}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SessionStateLabel}" Margin="7,0,0,0" FontSize="11.5"
                                               Foreground="{Binding SessionState, Converter={StaticResource StateBrush}}"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="本机设备 · 已加密" Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{Binding SessionStateLabel}" Style="{StaticResource Text.Display}"
                                   FontSize="30" Margin="0,18,0,0"/>
                        <TextBlock Grid.Row="2" Text="{Binding SessionDescription}" Style="{StaticResource Text.Secondary}"
                                   FontSize="13.5" Margin="0,7,0,0" MaxWidth="460" HorizontalAlignment="Left"
                                   TextWrapping="Wrap"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="共享我的屏幕" Style="{StaticResource Button.Primary}" Padding="18,9"
                                    Command="{Binding OpenShareCommand}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="共享我的屏幕" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Content="用配对码连接" Style="{StaticResource Button.Secondary}" Padding="16,9"
                                    Margin="10,0,0,0" Command="{Binding OpenConnectCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="本机" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding DeviceName}" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,10,0,2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="2" Text="{Binding DeviceIdShort}" Style="{StaticResource Text.Mono}"/>

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="IPv4" Style="{StaticResource Text.Caption}" Width="44"/>
                                <TextBlock Text="{Binding Ipv4Summary}" Style="{StaticResource Text.Mono}" Margin="44,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="IPv6" Style="{StaticResource Text.Caption}" Width="44"/>
                                <TextBlock Text="{Binding Ipv6Summary}" Style="{StaticResource Text.Mono}" Margin="44,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="4" Style="{StaticResource Banner.Warning}" VerticalAlignment="Bottom"
                                Margin="0,16,0,0"
                                Visibility="{Binding HealthNote, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <TextBlock Text="{Binding HealthNote}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </Border>

                        <Button Grid.Row="5" Content="高级设置" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Padding="0" Margin="0,12,0,0" Command="{Binding OpenSettingsCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 中部：快速连接与最近设备 -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="快速连接" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="一次性配对码 · 5 分钟内有效" Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="输入对方设备上显示的 6 位配对码，双方确认后即可建立加密连接。"
                                   Style="{StaticResource Text.Secondary}" Margin="0,5,0,12" TextWrapping="Wrap"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="JoinCodeBox" Style="{StaticResource TextBox.Base}" FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="19" FontWeight="SemiBold" Text="{Binding JoinCode, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="6" Padding="12,8" VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding JoinCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="0 0 0 0 0 0" FontFamily="{DynamicResource Font.Mono}" FontSize="19"
                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="13,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=JoinCodeBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Content="加入连接" Style="{StaticResource Button.Primary}"
                                    Command="{Binding JoinCommand}" MinWidth="92"/>
                            <Button Grid.Column="4" Content="创建配对码" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding CreatePairingCommand}"/>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                                       Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="媒体流使用 DTLS-SRTP 加密，信令服务只转发协商信息" Style="{StaticResource Text.Caption}"
                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="最近设备" Style="{StaticResource Text.Section}"/>
                            <Button Content="设备中心" Style="{StaticResource Button.Ghost}" Padding="4,0"
                                    HorizontalAlignment="Right" FontSize="12" Command="{Binding OpenDevicesCommand}"/>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding RecentDevices}"
                                          Visibility="{Binding HasRecentDevices, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceGlyph}}"
                                                           FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding LastSeenAt, Converter={StaticResource RelativeTime}}"
                                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasRecentDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE772;" FontFamily="{DynamicResource Font.Icon}" FontSize="24"
                                           Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="还没有连接过的设备" Style="{StaticResource Text.Secondary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="完成一次配对后会显示在这里" Style="{StaticResource Text.Caption}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部状态条 -->
            <Border Grid.Row="2" Style="{StaticResource Card.Flat}" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" FontFamily="{DynamicResource Font.Icon}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="局域网发现" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding DiscoveryStatus}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="隐私" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="不录制、不上传屏幕内容" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="版本" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
