<UserControl x:Class="LinkView.Windows.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,0,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}" MinWidth="118">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="运行检查" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Content="导出诊断报告" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="&#xE895;" FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="Spin" CenterX="6" CenterY="6"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinStory">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinStory"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Banner.Info}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                <TextBlock Margin="9,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="所有检查均来自真实的本机网络、DNS、HTTP 与 STUN 请求。STUN 可达并不保证 WebRTC 一定能穿透 NAT；最终结果以实际 ICE 协商为准。"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Checks}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,2" CornerRadius="{DynamicResource R.Md}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Top"
                                                    Background="{DynamicResource Brush.SurfaceAlt}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource CheckStatusGlyph}}"
                                                           FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                                                           Foreground="{Binding Status, Converter={StaticResource CheckStatusBrush}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Caption}"
                                                               Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource EnumLabel}}"
                                                       FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"
                                                       Foreground="{Binding Status, Converter={StaticResource CheckStatusBrush}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource Font.Icon}" FontSize="28"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Text="点击“运行检查”开始诊断" Style="{StaticResource Text.Secondary}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="本机网络接口" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="链路本地 IPv6 地址不会被当作可公网直连的地址。" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,3,0,10"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Interfaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding InterfaceName}" FontSize="12" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Address}" FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding InterfaceType}" Style="{StaticResource Text.Caption}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,0,3"
                                                    Background="{DynamicResource Brush.AccentSoft}">
                                                <TextBlock Text="{Binding Scope, Converter={StaticResource EnumLabel}}" FontSize="10" Foreground="{DynamicResource Brush.Accent}"/>
                                            </Border>
                                            <TextBlock Text="可用" Style="{StaticResource Text.Caption}" FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsUsableForConnection, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="不用于连接" Style="{StaticResource Text.Caption}" FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsUsableForConnection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
