<UserControl x:Class="LinkView.Windows.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,0,32,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 主操作区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton GroupName="ConnectMode" Style="{StaticResource Chip}" Content="创建连接"
                                     Padding="16,7" FontSize="12.5"
                                     IsChecked="{Binding ModeIndex, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=TwoWay}"/>
                        <RadioButton GroupName="ConnectMode" Style="{StaticResource Chip}" Content="加入连接"
                                     Padding="16,7" FontSize="12.5"
                                     IsChecked="{Binding ModeIndex, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- 创建面板 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModeIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <TextBlock Text="让另一台设备加入你的会话" Style="{StaticResource Text.Hero}" FontSize="22"/>
                            <TextBlock Text="生成一次性配对码并发给对方。对方确认后，会话会立即建立；配对码到期或使用一次后失效。"
                                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,20"/>

                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource R.Lg}"
                                    Padding="24" MinHeight="150">
                                <Grid>
                                    <!-- 未生成 -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding PairingCode, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}" FontSize="26"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                        <TextBlock Text="尚未生成配对码" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock Text="点击下方按钮创建会话" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center" Margin="0,3,0,12"/>
                                        <Button Content="生成配对码" Style="{StaticResource Button.Primary}" MinWidth="130"
                                                HorizontalAlignment="Center" Command="{Binding CreatePairingCommand}"
                                                IsEnabled="{Binding CanCreate}"/>
                                    </StackPanel>

                                    <!-- 已生成 -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding PairingCode, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="配对码" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CodeText" Text="{Binding PairingCode}" FontFamily="{DynamicResource Font.Mono}"
                                                   FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding PairingRemaining}" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,10"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="复制配对码" Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding CopyCodeCommand}"/>
                                            <Button Content="取消" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                    Command="{Binding CancelCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Banner.Info}" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Margin="9,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="收到连接请求时，LinkView 会弹出确认窗口。未经你允许，任何设备都不能加入会话。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 加入面板 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModeIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <TextBlock Text="加入对方的会话" Style="{StaticResource Text.Hero}" FontSize="22"/>
                            <TextBlock Text="输入对方设备上显示的 6 位配对码。连接成功后将自动建立加密的点对点媒体通道。"
                                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,20"/>

                            <Grid>
                                <TextBox Style="{StaticResource TextBox.Code}" Text="{Binding JoinCode, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="6" HorizontalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding JoinCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="· · · · · ·" FontSize="30" Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JoinCode}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Content="加入连接" Style="{StaticResource Button.Primary}" Margin="0,12,0,0" Padding="14,10"
                                    Command="{Binding JoinCommand}" IsEnabled="{Binding CanJoin}"/>

                            <Border Style="{StaticResource Banner.Error}" Margin="0,14,0,0"
                                    Visibility="{Binding ErrorText, Converter={StaticResource StringNotEmptyToVisibility}}">
                                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"/>
                            </Border>

                            <Border Style="{StaticResource Banner.Info}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="当前状态" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 右侧信息 -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="连接步骤" Style="{StaticResource Text.Section}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,1,0,16">
                                <TextBlock Text="生成或输入配对码" FontWeight="Medium"/>
                                <TextBlock Text="配对码 5 分钟内有效，仅可使用一次" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                                <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,1,0,16">
                                <TextBlock Text="双方确认身份" FontWeight="Medium"/>
                                <TextBlock Text="只有被允许的设备才能加入会话" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                                <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,1,0,0">
                                <TextBlock Text="建立加密媒体连接" FontWeight="Medium"/>
                                <TextBlock Text="优先直连，必要时按配置使用中继" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="信令服务" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding SignalingServer}" Style="{StaticResource Text.Mono}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="信令服务只交换配对、SDP 与 ICE 信息，不转发屏幕画面。" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,10"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="手动地址" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="检查主机地址格式，并查看当前版本支持的连接方式。" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <TextBox Style="{StaticResource TextBox.Base}" FontFamily="{DynamicResource Font.Mono}"
                                 Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="检查地址" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0"
                                Command="{Binding ValidateManualAddressCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ManualAddressResult}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding ManualAddressResult, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
