<Window x:Class="LinkView.Windows.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkView" WindowStyle="None" WindowState="Maximized"
        Background="#05070A" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid>
        <Image x:Name="VideoImage" Source="{Binding RemoteImage}" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" MouseWheel="OnMouseWheel"
               MouseLeftButtonDown="OnImageMouseDown"/>
        <Border x:Name="Overlay" VerticalAlignment="Top" Background="#AA080C12" Padding="18,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource Font.Icon}" FontSize="16"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PeerName}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="适 应" Style="{StaticResource Button.Ghost}" Foreground="White" Click="FitClick"/>
                    <Button Content="填 充" Style="{StaticResource Button.Ghost}" Foreground="White" Click="FillClick"/>
                    <Button Content="1:1" Style="{StaticResource Button.Ghost}" Foreground="White" Click="OriginalClick"/>
                    <Button Content="&#xE711;" FontFamily="{DynamicResource Font.Icon}" Style="{StaticResource Button.Ghost}"
                            Foreground="White" Click="CloseClick" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock Text="Esc 退出全屏 · 滚轮缩放" Foreground="#99FFFFFF" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
    </Grid>
</Window>
