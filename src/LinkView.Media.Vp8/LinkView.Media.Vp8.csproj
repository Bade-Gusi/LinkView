<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SIPSorceryMedia.Encoders</RootNamespace>
    <AssemblyName>LinkView.Media.Vp8</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS1573;CA1063;CA1816;CA5394;CA1401</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.17" />
  </ItemGroup>
  <ItemGroup>
    <None Include="native\vpxmd.dll" CopyToOutputDirectory="PreserveNewest" Link="vpxmd.dll" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" Link="VP8-LICENSE.txt" />
  </ItemGroup>
</Project>
