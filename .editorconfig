root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.cs]
indent_style = space
indent_size = 4

[*.kt]
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,xml,xaml,csproj,props,targets,kts}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
