<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：偏冷的纸张感，避免纯白大面积刺眼 -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EDF1F6"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E9EEF5"/>
    <SolidColorBrush x:Key="Brush.SurfaceActive" Color="#DFE6F0"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#DDE3EB"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C6D0DD"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#16202C"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#576678"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8493A5"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#2F6FEB"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#225FD4"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1C50B8"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E4EDFC"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#B9CEF5"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#0F8A5F"/>
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E1F4EC"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#A3650A"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FBF0DC"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#C23B3B"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBE9E9"/>
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#E8F0FB"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#66101820"/>
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#E3E9F1"/>
    <SolidColorBrush x:Key="Brush.VideoBackground" Color="#10161E"/>
    <SolidColorBrush x:Key="Brush.VideoOverlay" Color="#990B1017"/>
</ResourceDictionary>
