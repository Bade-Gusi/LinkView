<UserControl x:Class="LinkView.Windows.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LinkView.Windows.Controls">
    <Grid Margin="32,0,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 无会话 -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Padding="32"
                Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel>
                <TextBlock Text="&#xE9D2;" FontFamily="{DynamicResource Font.Icon}" FontSize="30"
                           Foreground="{DynamicResource Brush.TextTertiary}"/>
                <TextBlock Text="尚无可监控的会话" Style="{StaticResource Text.Hero}" FontSize="22" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                <TextBlock Text="建立连接并开始共享后，这里只会展示真实采集到的指标；无法获取的指标会明确标注为“不支持”。"
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,0,0,28">
                <!-- 会话概览 -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding PeerName}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PathLabel}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="连接时长" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource Font.Mono}" FontSize="18"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="角色" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding RoleText}" FontSize="14" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="编码" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding Codec}" FontSize="14" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 指标卡 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="发送" Style="{StaticResource Text.Caption}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SendFps}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text=" fps" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                <TextBlock Text="{Binding SendBitrate}" FontSize="24" FontWeight="SemiBold" Margin="16,0,0,0"/>
                                <TextBlock Text=" kbps" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SendResolution}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="接收" Style="{StaticResource Text.Caption}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ReceiveFps}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text=" fps" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                <TextBlock Text="{Binding ReceiveBitrate}" FontSize="24" FontWeight="SemiBold" Margin="16,0,0,0"/>
                                <TextBlock Text=" kbps" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ReceiveResolution}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="编解码耗时" Style="{StaticResource Text.Caption}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding EncodeMs}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text=" ms 编码" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="2,0,8,4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding DecodeMs}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text=" ms 解码" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="传输路径" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding PathLabel}" FontSize="13" FontWeight="Medium" Margin="0,7,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="连接路径由真实的 ICE 协商状态描述，不伪造更细粒度的中继信息。" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 图表 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="发送码率" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="kbps" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <controls:Sparkline Height="58" Margin="0,8,0,0"
                                                Values="{Binding SendKbpsSeries}"
                                                Stroke="{DynamicResource Brush.Accent}"/>
                            <controls:Sparkline Height="38" Margin="0,6,0,0"
                                                Values="{Binding SendFpsSeries}"
                                                Stroke="{DynamicResource Brush.Success}" ShowArea="False"/>
                            <TextBlock Text="曲线来自实际编码并发送的样本；网络变差时样本会自然下降。" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="接收码率" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="kbps" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <controls:Sparkline Height="58" Margin="0,8,0,0"
                                                Values="{Binding ReceiveKbpsSeries}"
                                                Stroke="{DynamicResource Brush.Accent}"/>
                            <controls:Sparkline Height="38" Margin="0,6,0,0"
                                                Values="{Binding ReceiveFpsSeries}"
                                                Stroke="{DynamicResource Brush.Success}" ShowArea="False"/>
                            <TextBlock Text="仅在真实收到 RTP 视频数据时计数，不会用占位数字制造“正在接收”的假象。"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 明细与限制 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="连接状态" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding ConnectionState}" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="ICE 状态" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding IceState}" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="采集源" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding CaptureSource}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="最近收到画面" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding LastVideo}" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="重连次数" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding Reconnects}" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="冻结次数" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="0（未实现自动冻结检测）" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card.Flat}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="尚未支持的指标" Style="{StaticResource Text.Section}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="RTT" Style="{StaticResource Text.Caption}" Width="52"/>
                                <TextBlock Text="{Binding RttText}" FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="丢包" Style="{StaticResource Text.Caption}" Width="52" Margin="16,0,0,0"/>
                                <TextBlock Text="{Binding LossText}" FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="抖动" Style="{StaticResource Text.Caption}" Width="52" Margin="16,0,0,0"/>
                                <TextBlock Text="{Binding JitterText}" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MetricsNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
