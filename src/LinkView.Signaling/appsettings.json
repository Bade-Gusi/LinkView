{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5180"
      }
    }
  },
  "Signaling": {
    "MaxConnections": 2000,
    "MaxSessions": 1000,
    "MaxSessionsPerDevice": 2,
    "MaxMessagesPerSecondPerConnection": 40,
    "HeartbeatTimeoutSeconds": 180,
    "CleanupIntervalSeconds": 30,
    "NegotiationTimeoutSeconds": 120
  }
}
