<UserControl x:Class="LinkView.Windows.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,0,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox Style="{StaticResource ComboBox}" Width="150" ItemsSource="{Binding LevelFilters}"
                          SelectedIndex="{Binding MinimumLevelIndex}"/>
                <Grid Width="240" Margin="10,0,0,0">
                    <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="30,7,10,7"/>
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="清除内存日志" Style="{StaticResource Button.Ghost}" Command="{Binding ClearCommand}"/>
                <Button Content="导出诊断报告" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                        Command="{Binding ExportDiagnosticsCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,28">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" CornerRadius="{DynamicResource R.Sm}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                                   Style="{StaticResource Text.Mono}" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontFamily="{DynamicResource Font.Mono}"
                                                   FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Top"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CategoryShort}" Style="{StaticResource Text.Mono}"
                                                   VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Text="{Binding Exception}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap"
                                                       MaxHeight="90" Margin="0,3,0,0"
                                                       Visibility="{Binding Exception, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Style="{StaticResource Button.Icon}" Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="复制此条日志">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextTertiary}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE9D5;" FontFamily="{DynamicResource Font.Icon}" FontSize="28"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}"/>
                    <TextBlock Text="没有匹配的日志" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
