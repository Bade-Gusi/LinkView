<Application x:Class="LinkView.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LinkView.Windows.Converters"
             xmlns:vm="clr-namespace:LinkView.Windows.ViewModels"
             xmlns:views="clr-namespace:LinkView.Windows.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器 -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
            <conv:StateLabelConverter x:Key="StateLabel"/>
            <conv:StateBrushConverter x:Key="StateBrush"/>
            <conv:StateSoftBrushConverter x:Key="StateSoftBrush"/>
            <conv:EnumLabelConverter x:Key="EnumLabel"/>
            <conv:DeviceGlyphConverter x:Key="DeviceGlyph"/>
            <conv:CheckStatusBrushConverter x:Key="CheckStatusBrush"/>
            <conv:CheckStatusGlyphConverter x:Key="CheckStatusGlyph"/>
            <conv:LogLevelBrushConverter x:Key="LogLevelBrush"/>
            <conv:BytesToTextConverter x:Key="BytesToText"/>
            <conv:DurationToTextConverter x:Key="DurationToText"/>
            <conv:RelativeTimeConverter x:Key="RelativeTime"/>
            <conv:AccentColorToBrushConverter x:Key="AccentColorToBrush"/>
            <conv:IntEqualsToBoolConverter x:Key="IntEquals"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibility"/>

            <!-- 页面映射 -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
                <views:DevicesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
                <views:ConnectView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShareViewModel}">
                <views:ShareView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                <views:MonitorView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
