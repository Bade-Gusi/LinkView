<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 字体：优先 Windows 11 的 Segoe UI Variable，回退到 Segoe UI / 微软雅黑 -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Medium">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">21</sys:Double>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.Hero">40</sys:Double>
    <sys:Double x:Key="FontSize.Code">30</sys:Double>

    <sys:Double x:Key="FontWeight.Normal">400</sys:Double>
    <sys:Double x:Key="FontWeight.Medium">500</sys:Double>
    <sys:Double x:Key="FontWeight.SemiBold">600</sys:Double>

    <Thickness x:Key="Spacing.Xs">4</Thickness>
    <Thickness x:Key="Spacing.Sm">8</Thickness>
    <Thickness x:Key="Spacing.Md">12</Thickness>
    <Thickness x:Key="Spacing.Lg">16</Thickness>
    <Thickness x:Key="Spacing.Xl">24</Thickness>
    <Thickness x:Key="Spacing.Xxl">32</Thickness>
    <Thickness x:Key="PagePadding">32,24,32,28</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>

    <CornerRadius x:Key="R.Sm">6</CornerRadius>
    <CornerRadius x:Key="R.Md">10</CornerRadius>
    <CornerRadius x:Key="R.Lg">14</CornerRadius>
    <CornerRadius x:Key="R.Pill">999</CornerRadius>

    <Duration x:Key="Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Duration.Normal">0:0:0.18</Duration>
    <Duration x:Key="Duration.Slow">0:0:0.28</Duration>

