<UserControl x:Class="LinkView.Windows.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,0,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="32,7,10,7"/>
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="搜索设备名称或备注" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                           Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Success}"
                         Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVisibility}}"/>
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.TextTertiary}"
                         Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                <TextBlock Text="{Binding DiscoveryStatus}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding RestartDiscoveryCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="重新搜索" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,28">
                <!-- 已保存设备 -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="已保存与收藏" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="设备备注与收藏保存在本机" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,18">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Saved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource R.Md}" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.SurfaceAlt}">
                                                <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceGlyph}}"
                                                           FontFamily="{DynamicResource Font.Icon}" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="5,1"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="收藏" FontSize="10" Foreground="{DynamicResource Brush.Accent}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding LastSeenAt, Converter={StaticResource RelativeTime}}"
                                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Grid.Column="3" Style="{StaticResource Button.Icon}"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="收藏/取消收藏">
                                                <TextBlock FontFamily="{DynamicResource Font.Icon}" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE734;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE735;"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <Button Content="配对" Style="{StaticResource Button.Ghost}" FontSize="12"
                                                        Command="{Binding DataContext.PairSavedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Button.Icon}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="移除已保存设备">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="还没有保存的设备。完成一次配对后，设备会出现在这里。" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   Margin="10,12" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Saved.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 附近设备 -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="附近设备" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="同一局域网内广播的 LinkView 设备" Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Nearby}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource R.Md}" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.SurfaceAlt}">
                                                <TextBlock Text="{Binding DeviceType, Converter={StaticResource DeviceGlyph}}"
                                                           FontFamily="{DynamicResource Font.Icon}" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                                    <Border Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                                        <TextBlock Text="在线" FontSize="10" Foreground="{DynamicResource Brush.Success}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Addresses}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="3"
                                                                    Padding="5,1" Margin="0,0,5,0">
                                                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource Font.Mono}"
                                                                           FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding AppVersion, StringFormat=LinkView {0}}"
                                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Content="配对" Style="{StaticResource Button.Secondary}" FontSize="12"
                                                        Command="{Binding DataContext.PairNearbyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Button.Icon}" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="复制地址">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,36,0,32" HorizontalAlignment="Center"
                                    Visibility="{Binding HasNearbyDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="&#xE701;" FontFamily="{DynamicResource Font.Icon}" FontSize="28"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}"/>
                            <TextBlock Text="附近没有发现设备" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="请确认双方在同一局域网，且没有启用客户端隔离或禁用多播。也可以直接使用配对码连接。"
                                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" MaxWidth="420"
                                       TextAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
