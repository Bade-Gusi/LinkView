<UserControl x:Class="LinkView.Windows.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,0,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="14" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource Font.Icon}" FontSize="25"
                                   Foreground="{DynamicResource Brush.TextOnAccent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LinkView" Style="{StaticResource Text.Hero}" FontSize="28"/>
                        <TextBlock Text="点对点屏幕共享 · Windows 客户端" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding OsVersion}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="10,5">
                            <TextBlock Text="{Binding AppVersion, StringFormat=版本 {0}}" FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="运行环境" Style="{StaticResource Text.Section}"/>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="运行时" Style="{StaticResource Text.Caption}" Width="72"/>
                            <TextBlock Text="{Binding Runtime}" Style="{StaticResource Text.Mono}" Margin="72,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="协议版本" Style="{StaticResource Text.Caption}" Width="72"/>
                            <TextBlock Text="{Binding ProtocolVersion}" Style="{StaticResource Text.Mono}" Margin="72,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="设备 ID" Style="{StaticResource Text.Caption}" Width="72"/>
                            <TextBlock Text="{Binding DeviceId}" Style="{StaticResource Text.Mono}" Margin="72,0,0,0" FontSize="9.5"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="隐私" Style="{StaticResource Text.Section}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,10,0,0"
                                   Text="LinkView 不会录制或上传屏幕内容。配对码、TURN 凭据与设备私钥分别受到短期失效、DPAPI 与公钥身份机制的约束。诊断报告在导出前会去除敏感字段。"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="当前验证范围" Style="{StaticResource Text.Section}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,10,0,0"
                                   Text="Windows 采集、VP8 编解码、WebRTC 建连与信令服务已在本机完成实际构建与测试。Android 客户端需要在具备 Android SDK 和真机的环境中构建并完成跨端互通验证，本交付不会声称已完成该验证。"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="第三方组件与许可证" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="以下组件均在项目中实际使用；许可证文件随安装目录一并分发。"
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,12"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="组件" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Text="版本" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="2" Text="许可证" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="3" Text="用途" Style="{StaticResource Text.Caption}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Licenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Text.Mono}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding License}" Style="{StaticResource Text.Mono}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Purpose}" Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
